# Default mode for the CLI and the dashboard toggle: mock | real
APP_MODE=mock

# SQLite by default. PostgreSQL works unchanged (the upsert uses ON CONFLICT on both):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/app_collector
DATABASE_URL=sqlite:///app_collector.db

# Real-time mode target. api_server.py serves a simulated upstream at /upstream.
UPSTREAM_BASE_URL=http://127.0.0.1:8000/upstream
# UPSTREAM_TOKEN=            # sent as "Authorization: Bearer <token>" when set
HTTP_TIMEOUT=10

# Retry policy (Retry-After from the server always wins over backoff)
MAX_RETRIES=3
BACKOFF_BASE=0.5
BACKOFF_MAX=30

LOG_LEVEL=INFO
